# ─── API Base URL ─────────────────────────────────────────────────────────────
# Base URL pointing to the FastAPI backend service
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# ─── Supabase Configuration ───────────────────────────────────────────────────
# Matches backend project - Anon/Public key is safe for client-side use
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ─── AI Real-time Gym Coach ───────────────────────────────────────────────────
# URL for the interactive AI real-time Streamlit coach service
EXPO_PUBLIC_AI_COACH_URL=http://localhost:8501
